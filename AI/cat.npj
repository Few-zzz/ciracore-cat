{
    "scene_array": [
        {
            "data": "{\n    \"connections\": [\n        {\n            \"in_id\": \"{1099f370-3f0b-4312-bad1-2d92f81265bd}\",\n            \"in_index\": 0,\n            \"out_id\": \"{32572cf8-d98d-4c34-a1f7-e9ec6ab7ae03}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{c81b211d-b50e-4247-95c6-339bea24793f}\",\n            \"in_index\": 0,\n            \"out_id\": \"{237bd951-30a0-497a-bd0f-ebfc6e56255c}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{32572cf8-d98d-4c34-a1f7-e9ec6ab7ae03}\",\n            \"in_index\": 0,\n            \"out_id\": \"{52c9eafd-fc09-442a-a26e-06f6cda4bbe6}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{db511f5a-fdd8-410b-95ab-af81659add08}\",\n            \"in_index\": 0,\n            \"out_id\": \"{1099f370-3f0b-4312-bad1-2d92f81265bd}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{3b174916-40cc-4217-afe7-dac000e383a2}\",\n            \"in_index\": 0,\n            \"out_id\": \"{32572cf8-d98d-4c34-a1f7-e9ec6ab7ae03}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{237bd951-30a0-497a-bd0f-ebfc6e56255c}\",\n            \"in_index\": 0,\n            \"out_id\": \"{1099f370-3f0b-4312-bad1-2d92f81265bd}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{52c9eafd-fc09-442a-a26e-06f6cda4bbe6}\",\n            \"in_index\": 0,\n            \"out_id\": \"{32572cf8-d98d-4c34-a1f7-e9ec6ab7ae03}\",\n            \"out_index\": 0\n        }\n    ],\n    \"nodes\": [\n        {\n            \"id\": \"{52c9eafd-fc09-442a-a26e-06f6cda4bbe6}\",\n            \"model\": {\n                \"name\": \"ButtonRun\"\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 266,\n                \"y\": 380\n            }\n        },\n        {\n            \"id\": \"{1099f370-3f0b-4312-bad1-2d92f81265bd}\",\n            \"model\": {\n                \"data\": {\n                    \"curr_tap\": 0,\n                    \"draw_roi\": true,\n                    \"enable_tracking\": false,\n                    \"font_scale\": 1.2,\n                    \"font_thickness\": 2,\n                    \"frame_buffer\": 5,\n                    \"is_roi_polygon\": false,\n                    \"map_det_cfgs\": [\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"A\",\n                            \"config_path\": \"C:/Users/wongs/Downloads/A\"\n                        }\n                    ],\n                    \"max_dist\": 150,\n                    \"nms\": 0.4,\n                    \"rect_thickness\": 2,\n                    \"result_drawing\": true,\n                    \"roi_h\": 50000,\n                    \"roi_polygon\": {\n                        \"pnt_count\": 33,\n                        \"roi_polygon_pts\": \"1415:1057,1109:1037,898:1037,673:1057,428:1045,65:1030,11:838,145:811,267:831,451:854,512:846,566:777,589:708,604:677,642:643,627:605,615:513,604:428,592:283,638:241,944:214,1067:164,1135:126,1338:126,1533:183,1728:237,1816:271,1835:360,1858:562,1870:762,1900:922,1885:1014,1866:1049,\",\n                        \"src_h\": 1080,\n                        \"src_w\": 1920\n                    },\n                    \"roi_w\": 50000,\n                    \"roi_x\": 0,\n                    \"roi_y\": 0,\n                    \"show_confidence\": true,\n                    \"text_drawing\": true,\n                    \"this_config_name\": \"A\",\n                    \"thresh\": 75,\n                    \"txt_offset\": 5\n                },\n                \"name\": \"DeepDetect \",\n                \"node_enable\": true,\n                \"obj_colors\": {\n                    \"array\": [\n                    ]\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 684,\n                \"y\": 361\n            }\n        },\n        {\n            \"id\": \"{db511f5a-fdd8-410b-95ab-af81659add08}\",\n            \"model\": {\n                \"height\": 445,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 762\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 950,\n                \"y\": 342\n            }\n        },\n        {\n            \"id\": \"{32572cf8-d98d-4c34-a1f7-e9ec6ab7ae03}\",\n            \"model\": {\n                \"data\": {\n                    \"filename\": \"C:/Users/wongs/Downloads/cat_Project.mp4\",\n                    \"height\": 275,\n                    \"loop\": true,\n                    \"width\": 284\n                },\n                \"name\": \"VideoFile\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 475,\n                \"y\": 361\n            }\n        },\n        {\n            \"id\": \"{237bd951-30a0-497a-bd0f-ebfc6e56255c}\",\n            \"model\": {\n                \"data\": {\n                    \"auto_start\": false,\n                    \"caption\": \"\",\n                    \"code\": \"#preparation here\\r\\n# ส่วนนี้รันครั้งเดียวตอนกด Start -> ตัวแปรด้านล่างจำค่าข้ามเฟรมได้\\r\\nimport math, time, json, threading, urllib.request\\r\\nfrom collections import Counter, deque\\r\\nimport cv2\\r\\n\\r\\n# ---- ส่งข้อมูลไป Next.js dashboard ----\\r\\nSERVER = \\\"http://127.0.0.1:3000\\\"\\r\\nEVENT_EVERY = 5.0               # ส่งผลพฤติกรรมทุกกี่วินาที (บันทึกลงฐานข้อมูล)\\r\\nDETECT_FPS = 5                  # ส่งกล่องตรวจจับกี่ครั้ง/วินาที (วาดทับภาพสดที่ cira_raw_video.py ส่ง)\\r\\nlast_event = 0.0\\r\\nlast_detect = 0.0\\r\\nbusy = {\\\"event\\\": False, \\\"detect\\\": False}   # ถ้ายังส่งอันก่อนไม่เสร็จ ข้ามไปเลย ไม่ให้ค้าง\\r\\nsend_warned = False\\r\\n\\r\\n# ---- บันทึกลง Google Sheet (ผ่าน Apps Script: google_sheet.gs) ----\\r\\n# วาง URL ของ Web app (ลงท้าย /exec) และรหัสลับเดียวกับที่ตั้งใน Apps Script; เว้นว่าง = ไม่บันทึก\\r\\nSHEET_URL = \\\"https://script.google.com/macros/s/AKfycbwVHxbeS7s3Pk6bskdY2apj0VRTr0GpJVqtG0COEWA9FPrKNliLAtANecBsC3dmAYR6/exec\\\"\\r\\nSHEET_SECRET = \\\"cat-2026-xyz789\\\"\\r\\n# หัวตาราง: ค่าพฤติกรรม = จำนวนแมวเฉลี่ยในนาทีนั้น (เช่น sleep 1.5 = นอนเฉลี่ย 1 ตัวครึ่ง)\\r\\nSHEET_HEAD = [\\\"minute_ts\\\", \\\"datetime\\\", \\\"monitored_s\\\", \\\"cat_count\\\",\\r\\n\\t\\t\\t  \\\"sleep\\\", \\\"walk\\\", \\\"play\\\", \\\"sit\\\", \\\"eat\\\", \\\"stand\\\", \\\"poop\\\"]\\r\\nsheet_acc = None                # ผลรวมของนาทีปัจจุบัน\\r\\nsheet_pending = []              # แถวที่ยังส่งไม่สำเร็จ (ส่งใหม่รอบหน้า)\\r\\nsheet_busy = False\\r\\nsheet_warned = False\\r\\n\\r\\ntracks = {}                     # id -> {\\\"c\\\": จุดกลาง, \\\"hist\\\": deque, \\\"miss\\\": จำนวนเฟรมที่หาย}\\r\\nnext_id = 0\\r\\n\\r\\n# ชื่อคลาสจากโมเดลใหม่: แมว 1 กล่องบอกพฤติกรรมมาเลย (Cat_Sleep, Cat_Walk, ...)\\r\\n# -> ไม่ต้องเดาพฤติกรรมจากการขยับ/สิ่งของรอบตัวแล้ว\\r\\nCAT_CLASSES = {\\r\\n\\t\\\"cat_sleep\\\": \\\"sleep\\\", \\\"cat_walk\\\": \\\"walk\\\", \\\"cat_play\\\": \\\"play\\\", \\\"cat_sit\\\": \\\"sit\\\",\\r\\n\\t\\\"cat_eat\\\": \\\"eat\\\", \\\"cat_stand\\\": \\\"stand\\\", \\\"cat_poop\\\": \\\"poop\\\",\\r\\n}\\r\\nOBJECT_CLASSES = {\\\"bed\\\", \\\"bowl\\\", \\\"poop\\\", \\\"sandbox\\\", \\\"toy\\\"}   # สิ่งของ ส่งไปวาดบนภาพสด\\r\\n\\r\\nCAT_CONF = 0.7                  # ตัดกล่องแมวมั่นใจต่ำ (ปรับได้ ถ้าเจอกล่องปลอมให้เพิ่ม)\\r\\nDUP_IOU = 0.5                   # กล่องแมวซ้อนกันเกินนี้ถือว่าเป็นตัวเดียวกัน (แม้คลาสต่างกัน)\\r\\nMATCH_PX = 150                  # ห่างจากเฟรมก่อนไม่เกินนี้ถือว่าเป็นตัวเดิม\\r\\nMAX_MISS = 15                   # หายเกินกี่เฟรมจึงลบ track ทิ้ง\\r\\nSMOOTH = 10                     # จำนวนเฟรมที่ใช้ majority vote กันพฤติกรรมกระพริบ\\r\\n\\r\\n\\r\\ndef to_box(o):\\r\\n\\t\\\"\\\"\\\"DeepDetect ให้ x,y เป็นจุดกึ่งกลางกล่อง -> แปลงเป็นมุมซ้ายบน\\\"\\\"\\\"\\r\\n\\tw, h = o[\\\"w\\\"], o[\\\"h\\\"]\\r\\n\\tname = str(o[\\\"name\\\"]).strip()\\r\\n\\treturn {\\\"name\\\": name, \\\"key\\\": name.lower(), \\\"conf\\\": float(o[\\\"confidence\\\"]),\\r\\n\\t\\t\\t\\\"x\\\": o[\\\"x\\\"] - w / 2, \\\"y\\\": o[\\\"y\\\"] - h / 2, \\\"w\\\": w, \\\"h\\\": h}\\r\\n\\r\\n\\r\\ndef find_objects(dd):\\r\\n\\treturn [to_box(o) for o in dd.get(\\\"objects\\\", [])]\\r\\n\\r\\n\\r\\ndef center(o):\\r\\n\\treturn (o[\\\"x\\\"] + o[\\\"w\\\"] / 2, o[\\\"y\\\"] + o[\\\"h\\\"] / 2)\\r\\n\\r\\n\\r\\ndef iou(a, b):\\r\\n\\tix = max(0, min(a[\\\"x\\\"] + a[\\\"w\\\"], b[\\\"x\\\"] + b[\\\"w\\\"]) - max(a[\\\"x\\\"], b[\\\"x\\\"]))\\r\\n\\tiy = max(0, min(a[\\\"y\\\"] + a[\\\"h\\\"], b[\\\"y\\\"] + b[\\\"h\\\"]) - max(a[\\\"y\\\"], b[\\\"y\\\"]))\\r\\n\\tinter = ix * iy\\r\\n\\treturn inter / (a[\\\"w\\\"] * a[\\\"h\\\"] + b[\\\"w\\\"] * b[\\\"h\\\"] - inter)\\r\\n\\r\\n\\r\\ndef dedupe(cats):\\r\\n\\t\\\"\\\"\\\"ตัดกล่องซ้ำของแมวตัวเดียวกัน เก็บกล่องที่มั่นใจกว่า\\\"\\\"\\\"\\r\\n\\tkeep = []\\r\\n\\tfor c in sorted(cats, key=lambda o: -o[\\\"conf\\\"]):\\r\\n\\t\\tif all(iou(c, k) < DUP_IOU for k in keep):\\r\\n\\t\\t\\tkeep.append(c)\\r\\n\\treturn keep\\r\\n\\r\\ndef match(cats):\\r\\n\\t\\\"\\\"\\\"จับคู่กล่องแมวกับ track เฟรมก่อน โดยเลือกคู่ที่ใกล้สุดก่อน (greedy)\\r\\n\\tคืน list ของ (track_id, ระยะที่ขยับ หรือ None ถ้าเป็นตัวใหม่) ตามลำดับ cats\\\"\\\"\\\"\\r\\n\\tglobal next_id\\r\\n\\tcenters = [center(c) for c in cats]\\r\\n\\tpairs = sorted((math.dist(centers[i], t[\\\"c\\\"]), tid, i)\\r\\n\\t\\t\\t\\t   for tid, t in tracks.items() for i in range(len(cats)))\\r\\n\\tassigned, used = {}, set()\\r\\n\\tfor d, tid, i in pairs:\\r\\n\\t\\tif d > MATCH_PX:\\r\\n\\t\\t\\tbreak\\r\\n\\t\\tif i in assigned or tid in used:\\r\\n\\t\\t\\tcontinue\\r\\n\\t\\tassigned[i] = (tid, d)\\r\\n\\t\\tused.add(tid)\\r\\n\\r\\n\\tfor tid in list(tracks):    # track ที่ไม่เจอในเฟรมนี้\\r\\n\\t\\tif tid not in used:\\r\\n\\t\\t\\ttracks[tid][\\\"miss\\\"] += 1\\r\\n\\t\\t\\tif tracks[tid][\\\"miss\\\"] > MAX_MISS:\\r\\n\\t\\t\\t\\tdel tracks[tid]\\r\\n\\r\\n\\tresult = []\\r\\n\\tfor i, c in enumerate(centers):\\r\\n\\t\\tif i in assigned:\\r\\n\\t\\t\\ttid, d = assigned[i]\\r\\n\\t\\telse:                   # ตัวใหม่\\r\\n\\t\\t\\ttid, d = next_id, None\\r\\n\\t\\t\\tnext_id += 1\\r\\n\\t\\t\\ttracks[tid] = {\\\"hist\\\": deque(maxlen=SMOOTH)}\\r\\n\\t\\ttracks[tid][\\\"c\\\"] = c\\r\\n\\t\\ttracks[tid][\\\"miss\\\"] = 0\\r\\n\\t\\tresult.append((tid, d))\\r\\n\\treturn result\\r\\n\\r\\n\\r\\ndef infer(objs):\\r\\n\\tcats = dedupe([o for o in objs if o[\\\"key\\\"] in CAT_CLASSES and o[\\\"conf\\\"] >= CAT_CONF])\\r\\n\\r\\n\\tout = []\\r\\n\\tfor box, (tid, _) in zip(cats, match(cats)):\\r\\n\\t\\thist = tracks[tid][\\\"hist\\\"]\\r\\n\\t\\thist.append(CAT_CLASSES[box[\\\"key\\\"]])\\r\\n\\t\\tout.append({\\r\\n\\t\\t\\t\\\"id\\\": tid,\\r\\n\\t\\t\\t\\\"behavior\\\": Counter(hist).most_common(1)[0][0],     # majority vote ต่อตัว\\r\\n\\t\\t\\t\\\"conf\\\": round(box[\\\"conf\\\"], 3),\\r\\n\\t\\t\\t\\\"x\\\": round(box[\\\"x\\\"]), \\\"y\\\": round(box[\\\"y\\\"]), \\\"w\\\": box[\\\"w\\\"], \\\"h\\\": box[\\\"h\\\"],\\r\\n\\t\\t})\\r\\n\\r\\n\\treturn {\\r\\n\\t\\t\\\"ts\\\": int(time.time() * 1000),                  # เวลาเครื่อง ไม่ต้องแปลงเลขไทย\\r\\n\\t\\t\\\"cat_count\\\": len(out),\\r\\n\\t\\t\\\"counts\\\": dict(Counter(c[\\\"behavior\\\"] for c in out)),\\r\\n\\t\\t\\\"cats\\\": out,\\r\\n\\t}\\r\\n\\r\\n\\r\\ndef post_async(kind, path, data):\\r\\n\\t\\\"\\\"\\\"POST JSON ใน thread แยก ไม่ให้ flow ของ CiRA ช้าลง\\\"\\\"\\\"\\r\\n\\tif busy[kind]:\\r\\n\\t\\treturn\\r\\n\\tbusy[kind] = True\\r\\n\\r\\n\\tdef run():\\r\\n\\t\\tglobal send_warned\\r\\n\\t\\ttry:\\r\\n\\t\\t\\treq = urllib.request.Request(SERVER + path, data=json.dumps(data).encode(),\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t headers={\\\"Content-Type\\\": \\\"application/json\\\"})\\r\\n\\t\\t\\turllib.request.urlopen(req, timeout=2).read()\\r\\n\\t\\t\\tsend_warned = False\\r\\n\\t\\texcept Exception as e:\\r\\n\\t\\t\\tif not send_warned:  # เตือนครั้งเดียว ไม่ให้ console รก ตอน dashboard ยังไม่เปิด\\r\\n\\t\\t\\t\\tprint(\\\"send to dashboard failed:\\\", repr(e))\\r\\n\\t\\t\\t\\tsend_warned = True\\r\\n\\t\\tfinally:\\r\\n\\t\\t\\tbusy[kind] = False\\r\\n\\r\\n\\tthreading.Thread(target=run, daemon=True).start()\\r\\n\\r\\n\\r\\ndef send_to_dashboard(result, objs, dd, img):\\r\\n\\tglobal last_event, last_detect\\r\\n\\tnow = time.time()\\r\\n\\tif now - last_event >= EVENT_EVERY:\\r\\n\\t\\tlast_event = now\\r\\n\\t\\tpost_async(\\\"event\\\", \\\"/api/events\\\", result)\\r\\n\\r\\n\\tif now - last_detect >= 1 / DETECT_FPS:\\r\\n\\t\\tlast_detect = now\\r\\n\\t\\t# พิกัดกล่องอิงขนาดภาพเต็มที่ DeepDetect ใช้\\r\\n\\t\\tw = dd.get(\\\"im_w\\\") or (img.shape[1] if img is not None else 0)\\r\\n\\t\\th = dd.get(\\\"im_h\\\") or (img.shape[0] if img is not None else 0)\\r\\n\\t\\tothers = [{\\\"name\\\": o[\\\"name\\\"], \\\"conf\\\": round(o[\\\"conf\\\"], 3), \\\"x\\\": round(o[\\\"x\\\"]),\\r\\n\\t\\t\\t\\t   \\\"y\\\": round(o[\\\"y\\\"]), \\\"w\\\": o[\\\"w\\\"], \\\"h\\\": o[\\\"h\\\"]}\\r\\n\\t\\t\\t\\t  for o in objs if o[\\\"key\\\"] in OBJECT_CLASSES]\\r\\n\\t\\tpost_async(\\\"detect\\\", \\\"/api/detections\\\", {\\\"ts\\\": result[\\\"ts\\\"], \\\"w\\\": w, \\\"h\\\": h,\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t  \\\"objects\\\": others, \\\"cats\\\": result[\\\"cats\\\"]})\\r\\n\\r\\n\\r\\ndef sheet_record(result):\\r\\n\\t\\\"\\\"\\\"เก็บผลทุกเฟรมไว้รวมเป็นรายนาที พอขึ้นนาทีใหม่ค่อยส่งแถวของนาทีก่อนขึ้น Sheet (1 แถว/นาที)\\\"\\\"\\\"\\r\\n\\tglobal sheet_acc\\r\\n\\tif not SHEET_URL:\\r\\n\\t\\treturn\\r\\n\\tnow = time.time()\\r\\n\\tminute = int(now // 60) * 60\\r\\n\\tif sheet_acc and sheet_acc[\\\"minute\\\"] != minute:\\r\\n\\t\\ta = sheet_acc\\r\\n\\t\\tn = a[\\\"frames\\\"]\\r\\n\\t\\tdata = []\\r\\n\\t\\tfor key in SHEET_HEAD:\\r\\n\\t\\t\\tif key == \\\"minute_ts\\\":\\r\\n\\t\\t\\t\\tdata.append(a[\\\"minute\\\"] * 1000)\\r\\n\\t\\t\\telif key == \\\"datetime\\\":\\r\\n\\t\\t\\t\\tdata.append(time.strftime(\\\"%Y-%m-%d %H:%M\\\", time.localtime(a[\\\"minute\\\"])))\\r\\n\\t\\t\\telif key == \\\"monitored_s\\\":\\r\\n\\t\\t\\t\\tdata.append(len(a[\\\"seconds\\\"]))          # มีข้อมูลกี่วินาทีในนาทีนี้\\r\\n\\t\\t\\telse:\\r\\n\\t\\t\\t\\tdata.append(round(a[\\\"sum\\\"].get(key, 0) / n, 3))\\r\\n\\t\\tsheet_pending.append(data)\\r\\n\\t\\tdel sheet_pending[:-1440]                       # เก็บค้างได้ไม่เกิน 1 วัน กันหน่วยความจำบวม\\r\\n\\t\\tsheet_acc = None\\r\\n\\t\\tsheet_send()\\r\\n\\tif sheet_acc is None:\\r\\n\\t\\tsheet_acc = {\\\"minute\\\": minute, \\\"frames\\\": 0, \\\"seconds\\\": set(), \\\"sum\\\": Counter()}\\r\\n\\tsheet_acc[\\\"frames\\\"] += 1\\r\\n\\tsheet_acc[\\\"seconds\\\"].add(int(now))\\r\\n\\tsheet_acc[\\\"sum\\\"][\\\"cat_count\\\"] += result[\\\"cat_count\\\"]\\r\\n\\tsheet_acc[\\\"sum\\\"].update(result[\\\"counts\\\"])\\r\\n\\r\\n\\r\\ndef sheet_send():\\r\\n\\t\\\"\\\"\\\"ส่งแถวที่ค้างทั้งหมดใน thread แยก (Apps Script ตอบช้า 1-3 วิ ไม่ให้ flow ของ CiRA ค้าง)\\\"\\\"\\\"\\r\\n\\tglobal sheet_busy\\r\\n\\tif sheet_busy or not sheet_pending:\\r\\n\\t\\treturn\\r\\n\\tsheet_busy = True\\r\\n\\trows = list(sheet_pending)\\r\\n\\r\\n\\tdef run():\\r\\n\\t\\tglobal sheet_busy, sheet_warned\\r\\n\\t\\ttry:\\r\\n\\t\\t\\tbody = json.dumps({\\\"secret\\\": SHEET_SECRET, \\\"rows\\\": rows}).encode()\\r\\n\\t\\t\\treq = urllib.request.Request(SHEET_URL, data=body, headers={\\\"Content-Type\\\": \\\"text/plain\\\"})\\r\\n\\t\\t\\tres = json.loads(urllib.request.urlopen(req, timeout=30).read())\\r\\n\\t\\t\\tif res.get(\\\"error\\\"):\\r\\n\\t\\t\\t\\traise RuntimeError(res[\\\"error\\\"])\\r\\n\\t\\t\\tdel sheet_pending[:len(rows)]               # ส่งสำเร็จ ลบออกจากคิว\\r\\n\\t\\t\\tsheet_warned = False\\r\\n\\t\\texcept Exception as e:\\r\\n\\t\\t\\tif not sheet_warned:\\r\\n\\t\\t\\t\\tprint(\\\"send to Google Sheet failed (retry next minute):\\\", repr(e))   # ภาษาอังกฤษ: console บางเครื่องพิมพ์ไทยไม่ได้\\r\\n\\t\\t\\t\\tsheet_warned = True\\r\\n\\t\\tfinally:\\r\\n\\t\\t\\tsheet_busy = False\\r\\n\\r\\n\\tthreading.Thread(target=run, daemon=True).start()\\r\\n\\r\\n\\r\\ndef handle_request(req):\\r\\n\\tpayload, img = getReqData(req)\\r\\n\\r\\n\\ttry:\\r\\n\\t\\t# payload อาจเป็น {\\\"DeepDetect\\\": ...} หรือ {\\\"payload\\\": {\\\"DeepDetect\\\": ...}}\\r\\n\\t\\troot = payload.get(\\\"payload\\\", payload)\\r\\n\\t\\tdd = root.get(\\\"DeepDetect\\\", {})\\r\\n\\r\\n\\t\\tobjs = find_objects(dd)\\r\\n\\t\\tresult = infer(objs)\\r\\n\\t\\troot[\\\"CatBehavior\\\"] = result                    # ส่งต่อให้โหนดถัดไป\\r\\n\\t\\tsend_to_dashboard(result, objs, dd, img)\\r\\n\\t\\tsheet_record(result)\\r\\n\\r\\n\\t\\tif img is not None:     # เขียนพฤติกรรมลงภาพ ไว้ดูใน Debug\\r\\n\\t\\t\\tfor c in result[\\\"cats\\\"]:\\r\\n\\t\\t\\t\\tcv2.putText(img, f'#{c[\\\"id\\\"]} {c[\\\"behavior\\\"]}', (c[\\\"x\\\"], c[\\\"y\\\"] + c[\\\"h\\\"] - 10),\\r\\n\\t\\t\\t\\t\\t\\t\\tcv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 0, 255), 3)\\r\\n\\t\\t\\tsummary = \\\", \\\".join(f\\\"{k}:{v}\\\" for k, v in result[\\\"counts\\\"].items()) or \\\"no cat\\\"\\r\\n\\t\\t\\tcv2.putText(img, summary, (30, 60), cv2.FONT_HERSHEY_SIMPLEX, 1.5, (0, 0, 255), 4)\\r\\n\\texcept Exception as e:\\r\\n\\t\\tprint(\\\"CatBehavior error:\\\", repr(e))\\r\\n\\r\\n\\tresp = makeRespData(payload, img)\\r\\n\\treturn resp\\r\\n\",\n                    \"editor_setting\": {\n                        \"autoComplete\": {\n                            \"caseSensitivity\": true,\n                            \"enable\": true,\n                            \"threshold\": 3\n                        },\n                        \"indent\": {\n                            \"enable\": true\n                        },\n                        \"theme\": \"Material Dark\",\n                        \"whitespace\": {\n                            \"enable\": false,\n                            \"size\": 2\n                        }\n                    },\n                    \"icon\": \":/cira_bernoulli_python_plus/model/python_plus.png\",\n                    \"not_use_image\": false,\n                    \"python_path\": \"C:/Users/wongs/AppData/Local/Programs/Python/Python312/python.exe\"\n                },\n                \"name\": \"Python+\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 532,\n                \"y\": 494\n            }\n        },\n        {\n            \"id\": \"{c81b211d-b50e-4247-95c6-339bea24793f}\",\n            \"model\": {\n                \"height\": 281,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 709,\n                \"width\": 446\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 950,\n                \"y\": 836\n            }\n        },\n        {\n            \"id\": \"{3b174916-40cc-4217-afe7-dac000e383a2}\",\n            \"model\": {\n                \"data\": {\n                    \"auto_start\": false,\n                    \"caption\": \"\",\n                    \"code\": \"#preparation here\\r\\n# Python+ ตัวที่ 1: วางระหว่าง กล้อง -> [ตัวนี้] -> DeepDetect\\r\\n# ส่งภาพดิบ (ยังไม่มีกรอบ) ไปแสดงสดบน dashboard แล้วส่งภาพเดิมต่อให้ DeepDetect\\r\\nimport time, json, base64, threading, urllib.request\\r\\nimport cv2\\r\\n\\r\\nSERVER = \\\"http://127.0.0.1:3000\\\"\\r\\nFRAME_FPS = 30                  # ส่งภาพกี่เฟรม/วินาที (ได้จริงไม่เกินความเร็วของ flow ใน CiRA)\\r\\nFRAME_W = 960                   # ย่อภาพก่อนส่ง ลดขนาด\\r\\nlast_frame = 0.0\\r\\nbusy = {\\\"frame\\\": False}         # ถ้ายังส่งเฟรมก่อนไม่เสร็จ ข้ามไปเลย ไม่ให้ค้าง\\r\\nsend_warned = False\\r\\n\\r\\n\\r\\ndef post_async(data):\\r\\n\\tif busy[\\\"frame\\\"]:\\r\\n\\t\\treturn\\r\\n\\tbusy[\\\"frame\\\"] = True\\r\\n\\r\\n\\tdef run():\\r\\n\\t\\tglobal send_warned\\r\\n\\t\\ttry:\\r\\n\\t\\t\\treq = urllib.request.Request(SERVER + \\\"/api/frame\\\", data=json.dumps(data).encode(),\\r\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t headers={\\\"Content-Type\\\": \\\"application/json\\\"})\\r\\n\\t\\t\\turllib.request.urlopen(req, timeout=2).read()\\r\\n\\t\\t\\tsend_warned = False\\r\\n\\t\\texcept Exception as e:\\r\\n\\t\\t\\tif not send_warned:\\r\\n\\t\\t\\t\\tprint(\\\"send frame failed:\\\", repr(e))\\r\\n\\t\\t\\t\\tsend_warned = True\\r\\n\\t\\tfinally:\\r\\n\\t\\t\\tbusy[\\\"frame\\\"] = False\\r\\n\\r\\n\\tthreading.Thread(target=run, daemon=True).start()\\r\\n\\r\\n\\r\\ndef handle_request(req):\\r\\n\\tglobal last_frame\\r\\n\\tpayload, img = getReqData(req)\\r\\n\\r\\n\\ttry:\\r\\n\\t\\tnow = time.time()\\r\\n\\t\\tif img is not None and now - last_frame >= 1 / FRAME_FPS:\\r\\n\\t\\t\\tlast_frame = now\\r\\n\\t\\t\\th, w = img.shape[:2]\\r\\n\\t\\t\\tsmall = cv2.resize(img, (FRAME_W, int(h * FRAME_W / w))) if w > FRAME_W else img\\r\\n\\t\\t\\tok, buf = cv2.imencode(\\\".jpg\\\", small, [cv2.IMWRITE_JPEG_QUALITY, 70])\\r\\n\\t\\t\\tif ok:\\r\\n\\t\\t\\t\\tpost_async({\\\"ts\\\": int(now * 1000), \\\"w\\\": w, \\\"h\\\": h,\\r\\n\\t\\t\\t\\t\\t\\t\\t\\\"jpeg\\\": base64.b64encode(buf).decode()})\\r\\n\\texcept Exception as e:\\r\\n\\t\\tprint(\\\"raw video error:\\\", repr(e))\\r\\n\\r\\n\\tresp = makeRespData(payload, img)     # ส่งภาพเดิม (ไม่แก้ไข) ต่อให้ DeepDetect\\r\\n\\treturn resp\\r\\n\",\n                    \"editor_setting\": {\n                        \"autoComplete\": {\n                            \"caseSensitivity\": true,\n                            \"enable\": true,\n                            \"threshold\": 3\n                        },\n                        \"indent\": {\n                            \"enable\": true\n                        },\n                        \"theme\": \"Material Dark\",\n                        \"whitespace\": {\n                            \"enable\": false,\n                            \"size\": 2\n                        }\n                    },\n                    \"icon\": \":/cira_bernoulli_python_plus/model/python_plus.png\",\n                    \"not_use_image\": false,\n                    \"python_path\": \"C:/Users/wongs/AppData/Local/Programs/Python/Python312/python.exe\"\n                },\n                \"name\": \"Python+\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 361,\n                \"y\": 494\n            }\n        },\n        {\n            \"id\": \"{5d2f66f4-4ff4-4ae3-b545-a71df20874d0}\",\n            \"model\": {\n                \"data\": {\n                    \"auto_gen\": {\n                        \"blur_max\": 9,\n                        \"blur_step\": 9,\n                        \"contrast_max\": 1.2,\n                        \"contrast_min\": 0.2,\n                        \"contrast_step\": 1,\n                        \"fixed_size\": false,\n                        \"grb_blur\": false,\n                        \"grb_contrast\": true,\n                        \"grb_noise\": false,\n                        \"grb_rotation\": true,\n                        \"noise_max\": 10,\n                        \"noise_step\": 10,\n                        \"rot_max\": 180,\n                        \"rot_min\": -180,\n                        \"rot_step\": 90\n                    },\n                    \"auto_rect\": false,\n                    \"auto_rect_class\": \"\",\n                    \"auto_rect_h\": 10,\n                    \"auto_rect_w\": 10,\n                    \"batch_size\": 64,\n                    \"cmb_model\": \"V4-tiny\",\n                    \"dlg_lb_setting\": {\n                        \"contour_alpha\": 0.3,\n                        \"contour_bn_thickness\": 2,\n                        \"crosshair_thickness\": 1,\n                        \"font_offset\": 5,\n                        \"font_scale\": 1.2,\n                        \"font_thickness\": 2,\n                        \"line_thickness\": 2,\n                        \"rect_thickness\": 2\n                    },\n                    \"epochs\": 10000,\n                    \"export_crop\": {\n                        \"exp_constant\": false,\n                        \"exp_scale\": true,\n                        \"exp_scale_h\": 1,\n           